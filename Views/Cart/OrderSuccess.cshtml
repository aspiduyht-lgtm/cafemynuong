@model CafeWebsite.Models.Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-lg p-8 text-center">
            <div class="mb-6">
                <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="check-circle" class="h-12 w-12 text-green-600"></i>
                </div>
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Đặt hàng thành công!</h1>
                <p class="text-gray-600">Cảm ơn bạn đã đặt hàng tại Đức Tâm Coffee</p>
            </div>

            <div class="bg-amber-50 rounded-xl p-6 mb-6">
                <div class="text-sm text-gray-600 mb-2">Mã đơn hàng</div>
                <div class="text-2xl font-bold text-amber-600">@Model.Id.Substring(0, 8).ToUpper()</div>
            </div>

            <div class="border-t border-b border-gray-200 py-6 mb-6 text-left">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Thông tin đơn hàng</h2>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-gray-600">Người nhận:</span>
                        <span class="font-medium">@Model.CustomerName</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Số điện thoại:</span>
                        <span class="font-medium">@Model.CustomerPhone</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Địa chỉ:</span>
                        <span class="font-medium text-right">@Model.CustomerAddress</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600">Thanh toán:</span>
                        <span class="font-medium">@(Model.PaymentMethod == PaymentMethod.COD ? "Tiền mặt" : Model.PaymentMethod.ToString())</span>
                    </div>
                </div>
            </div>

            <div class="text-left mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Chi tiết đơn hàng</h2>
                <div class="space-y-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-600">@item.ProductName (@item.Size) x@item.Quantity</span>
                            <span class="font-medium">@((item.Price * item.Quantity).ToString("N0"))đ</span>
                        </div>
                    }
                </div>
                
                <div class="border-t border-gray-200 mt-4 pt-4 space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-gray-600">Tạm tính:</span>
                        <span>@Model.Subtotal.ToString("N0")đ</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="flex justify-between text-sm text-green-600">
                            <span>Giảm giá (@Model.PromotionCode):</span>
                            <span>-@Model.DiscountAmount.ToString("N0")đ</span>
                        </div>
                    }
                    <div class="flex justify-between text-lg font-bold text-amber-600">
                        <span>Tổng cộng:</span>
                        <span>@Model.Total.ToString("N0")đ</span>
                    </div>
                </div>
            </div>

            <div class="space-y-3">
                <a asp-controller="Home" asp-action="Index" class="block w-full bg-amber-600 text-white py-3 rounded-lg font-semibold hover:bg-amber-700 transition-colors no-underline">
                    Về trang chủ
                </a>
                <a asp-controller="Menu" asp-action="Index" class="block w-full bg-gray-100 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-200 transition-colors no-underline">
                    Tiếp tục mua hàng
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
